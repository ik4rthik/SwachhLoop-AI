# ============================================================
# SwachhLoop AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# --- Application ---
APP_ENV=development
DEBUG=true

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=8501
API_BASE_URL=http://localhost:8000

# --- Database ---
# Local development (SQLite — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./swachhloop.db

# Production (PostgreSQL / Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/swachhloop

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage ---
# local: store uploads on disk (development)
# s3:    store on AWS S3 / Supabase Storage (production, Phase 4+)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# --- Logging ---
LOG_LEVEL=INFO

# --- AI & Multi-Agent Services (Phase 4) ---
# Provider options: mock (default local fallback), gemini, openai
AI_PROVIDER=mock
AI_MODEL_NAME=mock-model

# Optional API Keys for cloud LLM/Vision providers (leave empty for local mock mode):
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# RAG Knowledge Base path for civic queries:
RAG_KNOWLEDGE_PATH=data/knowledge_base.json

# Geospatial Depot Coordinates (Kalady Town Center):
DEFAULT_DEPOT_LAT=10.1667
DEFAULT_DEPOT_LON=76.4333

# Verification change threshold (0.0 to 1.0):
CLEANUP_VERIFICATION_THRESHOLD=0.60
