# ============================================================
# SwachhLoop AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# DO NOT commit .env to version control.

# --- Application ---
APP_ENV=development
DEBUG=true

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend ---
FRONTEND_PORT=8501
API_BASE_URL=http://localhost:8000

# --- Database ---
# Local development (SQLite — no setup needed):
DATABASE_URL=sqlite+aiosqlite:///./swachhloop.db

# Production (PostgreSQL / Supabase):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/swachhloop

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Storage ---
# local: store uploads on disk (development)
# s3:    store on AWS S3 / Supabase Storage (production, Phase 4+)
STORAGE_BACKEND=local
UPLOAD_DIR=uploads

# --- Logging ---
LOG_LEVEL=INFO

# --- AI Services (Phase 4+ — leave empty for now) ---
# OPENAI_API_KEY=
# GOOGLE_MAPS_API_KEY=
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
