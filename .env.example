# ============================================================
# SwachhLoop AI — Environment Variable Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
#
#   cp .env.example .env
# ============================================================

# --- Application ---
APP_NAME=SwachhLoop AI
APP_VERSION=0.1.0
APP_ENV=development        # development | staging | production
DEBUG=true

# --- Backend Server ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# --- Frontend (Streamlit) ---
FRONTEND_PORT=8501
# URL the Streamlit app uses to talk to the FastAPI backend
API_BASE_URL=http://localhost:8000

# --- Database ---
# PostgreSQL connection string
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://swachhloop_user:changeme@localhost:5432/swachhloop_db

# --- Security (Phase 2+) ---
# Secret key for JWT token signing — generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_generate_a_secure_random_key
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Services (Phase 3+) ---
# OpenAI / Gemini API key (required when AI features are enabled)
# AI_API_KEY=your_api_key_here
# AI_MODEL=gemini-pro

# --- Storage (Phase 3+) ---
# For waste image uploads
# STORAGE_BACKEND=local          # local | s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=ap-south-1

# --- Logging ---
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR | CRITICAL
